# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081

# Database Configuration (MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Pagination / Security Secrets
CURSOR_SECRET=your_base64_or_random_secret_here

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_FEED_TTL_SECONDS=30
REDIS_POST_TTL_SECONDS=120
REDIS_COMMENTS_TTL_SECONDS=60
REDIS_FOLLOWS_TTL_SECONDS=300
REDIS_USER_TTL_SECONDS=300

# Media Uploads (ImageKit)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
